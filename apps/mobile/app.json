{
  "expo": {
    "name": "Quest",
    "slug": "quest-app",
    "scheme": "quest",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F0F11",
    "ios": {
      "bundleIdentifier": "com.example.quest",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.declared-age-range": true
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Take the photo for your daily quest. The camera opens only when you tap it.",
        "NSPhotoLibraryUsageDescription": "Pick a photo for your daily quest. Only the photo you choose is shared with the app."
      }
    },
    "android": {
      "package": "com.example.quest",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Take the photo for your daily quest. The camera opens only when you tap it.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a photo for your daily quest. Only the photo you choose is shared with the app.",
          "cameraPermission": "Take the photo for your daily quest. The camera opens only when you tap it.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
