# Copy to .env and fill in from the Supabase project's API settings.
# Only the public anon key goes in the app; the service role key never does.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Where parent invite links point: the parent consent page (package A8).
EXPO_PUBLIC_PARENT_SITE_URL=
# Plus in the app (RevenueCat's public SDK keys, one per store).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Terms of use and privacy policy, linked before buying Plus.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
