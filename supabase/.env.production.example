# Secrets for the production edge functions. Copy to supabase/.env.production
# (git ignores it), fill in, and run scripts/setup-production.sh. Empty lines
# are skipped. SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY
# are given to every function by Supabase.

# Shared secrets the schedules and triggers send. Make each one with:
#   openssl rand -hex 32
SAFETY_WEBHOOK_SECRET=
COACH_WEBHOOK_SECRET=
DROP_WEBHOOK_SECRET=
DELETIONS_WEBHOOK_SECRET=
QUESTS_WEBHOOK_SECRET=

# The coach (A4) and the quest writer (A6). Every review and draft is a paid
# Claude API call.
ANTHROPIC_API_KEY=

# The safety scan (A5). Leave empty until the vendors are chosen and their
# adapters added: until then nothing is scanned, and every photo waits.
SAFETY_VENDORS=

# Plus (A9). `npm run setup:stripe -- --write` fills the Stripe values
# (docs/payments-setup.md). PARENT_SITE_URL is for Stripe's return links.
PARENT_SITE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PLUS_EXTRA=
STRIPE_PORTAL_CONFIGURATION=
# Checkout works out tax with Stripe Tax; set to off only in an emergency.
STRIPE_AUTOMATIC_TAX=
# The value you also put in RevenueCat's webhook "Authorization header value",
# after "Bearer ". Make it with: openssl rand -hex 32
REVENUECAT_WEBHOOK_SECRET=

# Pushes (A10): only if push security is turned on in Expo.
EXPO_ACCESS_TOKEN=
