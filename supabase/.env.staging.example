# Secrets for the STAGING edge functions (the MVP on your team's phones). Copy
# to supabase/.env.staging (git ignores it), fill in, and run
# scripts/setup-staging.sh. Use different secrets from production. Empty lines
# are skipped. SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are
# given to every function by Supabase.

# Shared secrets the schedules and triggers send. Make each one with:
#   openssl rand -hex 32
SAFETY_WEBHOOK_SECRET=
COACH_WEBHOOK_SECRET=
DROP_WEBHOOK_SECRET=
DELETIONS_WEBHOOK_SECRET=
QUESTS_WEBHOOK_SECRET=

# The coach and the quest writer. Every review and draft is a paid Claude API
# call; a spending limit on this key is a good idea for staging.
ANTHROPIC_API_KEY=

# STAGING ONLY: the test safety vendors pass every photo except known test
# images, so your team's photos reach the coach before real vendors are
# chosen. Only staff photos, never real teens. setup-production.sh refuses this
# value for any other project.
SAFETY_VENDORS=test

# Plus isn't part of the MVP. Leave these empty: the payments function then
# answers "not set up", and 13–15s still get Plus free.
PARENT_SITE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PLUS_EXTRA=
STRIPE_PORTAL_CONFIGURATION=
STRIPE_AUTOMATIC_TAX=
REVENUECAT_WEBHOOK_SECRET=

# Pushes: only if push security is turned on in Expo.
EXPO_ACCESS_TOKEN=
