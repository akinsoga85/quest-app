{
  "name": "quest-app",
  "private": true,
  "description": "Daily creative quests for teens. Working name; rename once the brand is cleared.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "db:up": "bash scripts/db-local.sh up",
    "db:reset": "bash scripts/db-local.sh reset",
    "db:down": "bash scripts/db-local.sh down",
    "db:test": "node --import ./scripts/register-ts.mjs --test --test-concurrency=1 scripts/test-db.mjs scripts/test-db-a1.mjs scripts/test-db-a2.mjs scripts/test-db-a3.mjs scripts/test-db-a4.mjs scripts/test-db-a5.mjs",
    "gen:types": "node scripts/gen-db-types.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "coach": "node --import ./scripts/register-ts.mjs packages/coach/src/cli.ts",
    "build:functions": "esbuild packages/coach/src/supabase.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=supabase/functions/coach-review/coach.bundle.mjs --log-level=warning && esbuild packages/safety/src/supabase.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=supabase/functions/safety-scan/scan.bundle.mjs --log-level=warning"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/pg": "^8.15.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^16.0.0",
    "pg": "^8.23.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "react": "19.3.0"
  }
}
