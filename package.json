{
  "name": "quest-app",
  "private": true,
  "description": "Daily creative quests for teens. Working name; rename once the brand is cleared.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "db:up": "bash scripts/db-local.sh up",
    "db:reset": "bash scripts/db-local.sh reset",
    "db:down": "bash scripts/db-local.sh down",
    "db:test": "node --import ./scripts/register-ts.mjs --test --test-concurrency=1 scripts/test-db.mjs scripts/test-db-a1.mjs scripts/test-db-a2.mjs scripts/test-db-a3.mjs",
    "gen:types": "node scripts/gen-db-types.mjs",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/pg": "^8.15.0",
    "eslint": "^10.14.0",
    "globals": "^16.0.0",
    "pg": "^8.23.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "react": "19.3.0"
  }
}
